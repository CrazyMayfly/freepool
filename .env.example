# 百炼 API Key（业务空间专用 key）
BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxx
# OpenAI 兼容端点（业务空间端点或官方 dashscope 端点）
BAILIAN_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/token.db
# 免费额度默认规则（free_models.yaml 可按模型覆盖；看板「配置」页可改）
DEFAULT_TOTAL_TOKENS=1000000
DEFAULT_VALID_DAYS=90
# 剩余低于该比例标记为「偏低」（0-1 小数）
FREE_QUOTA_LOW_PERCENT=0.2
# 每日官方目录同步时间（0-23 时）
SYNC_HOUR=3
